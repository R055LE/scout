[Unit]
Description=Run one scout discovery digest
Documentation=https://github.com/R055LE/scout/blob/main/docs/scout.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=12min
# Runs as the non-root invoking user so Docker is not driven as root.
User=__DEPLOY_USER__
ExecStart=/usr/local/bin/scout-run
